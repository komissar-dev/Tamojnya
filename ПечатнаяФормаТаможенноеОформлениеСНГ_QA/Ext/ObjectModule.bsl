
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = Новый Структура;
	
	МассивНазначений = Новый Массив;
	МассивНазначений.Добавить("Документ.РеализацияТоваровУслуг");
	
	ПараметрыРегистрации.Вставить("Вид", Перечисления.ВидыДополнительныхОтчетовИОбработок.ПечатнаяФорма); 
	ПараметрыРегистрации.Вставить("Назначение", МассивНазначений);
	ПараметрыРегистрации.Вставить("Наименование", "Исходная информация для таможенного оформления (р)"); 
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Истина);
	ПараметрыРегистрации.Вставить("Версия", "1.0.0.0");    
	ПараметрыРегистрации.Вставить("Информация", "Исходная информация для таможенного оформления");   
	
	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	
	ДобавитьКоманду(ТаблицаКоманд,
					"Исходная информация для таможенного оформления (р)", 
					"ИсходнаяИнформацияДляТаможенногоОформления", 
					"ВызовСерверногоМетода", 
					Истина,
					"ПечатьMXL");
	
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

Функция ПолучитьТаблицуКоманд()
	
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка")); 
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));   
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	Возврат Команды;
	
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;  
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов,  КоллекцияПечатныхФорм, ОбъектыПечати = Неопределено, ПараметрыВывода =Неопределено) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ИсходнаяИнформацияДляТаможенногоОформления") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ИсходнаяИнформацияДляТаможенногоОформления",
			НСтр("ru = 'Исходная информация для таможенного оформления (р)';
				|en = 'Исходная информация для таможенного оформления (р)'"),
			СформироватьПечатнуюФормуДляТаможенногоОформления(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;
	
	
КонецПроцедуры 

Функция НайтиЕдиницуУпаковки(Код)
	// Поиск базовой единицы упаковки по числовому Коду ОКЕИ
	ЗапросЕд = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|   Ссылка
		|ИЗ
		|   Справочник.УпаковкиЕдиницыИзмерения
		|ГДЕ
		|   Код = &Код
		|   И Владелец = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)");
	ЗапросЕд.УстановитьПараметр("Код", Код);
	Рез = ЗапросЕд.Выполнить();
	Если Рез.Пустой() Тогда
		Возврат Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	КонецЕсли;
	Выб = Рез.Выбрать();
	Выб.Следующий();
	Возврат Выб.Ссылка;
КонецФункции

Функция СформироватьПечатнуюФормуДляТаможенногоОформления(МассивОбъектов, ОбъектыПечати = Неопределено, ПараметрыПечати = Неопределено) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ТаможенноеОформление";
	
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
	Макет = ПолучитьМакет("МакетТаможенноеОформление");
	
	Запрос = Новый Запрос; 
	Запрос.Текст = ТекстЗапросТаможенногоОФормления();
	Запрос.УстановитьПараметр("МассивОбъектов",МассивОбъектов);
	// Штука по коду ОКЕИ 796 (PCE)
	ЕдШтука = НайтиЕдиницуУпаковки("796");
	Запрос.УстановитьПараметр("Штука", ЕдШтука);

	РезультатЗапроса = Запрос.ВыполнитьПакет();

	ДанныеТаблицы = РезультатЗапроса[РезультатЗапроса.ВГраница()].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДанныеШапки = РезультатЗапроса[РезультатЗапроса.ВГраница()-1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДанныеТаблицыПоСериям = РезультатЗапроса[РезультатЗапроса.ВГраница()-2].Выгрузить();
	
	ТабличныйДокумент.Очистить();
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьИтог = Макет.ПолучитьОбласть("Итог");
	ОбластьИтогТНВЭД = Макет.ПолучитьОбласть("ИтогТНВЭД");
	
	//ТабличныйДокумент.НачатьАвтогруппировкуСтрок();
	Пока ДанныеШапки.Следующий() Цикл
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		СтруктураДанныхШапки = Новый Структура();
		СтруктураДанныхШапки.Вставить("НомерСФ",ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДанныеШапки.НомерСФ,Истина,Истина));
		СтруктураДанныхШапки.Вставить("ДатаСФ",Формат(ДанныеШапки.ДатаСФ,"ДФ=dd.MM.yyyy"));
		
		ДанныеПродавца = ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ДанныеШапки.Организация, ДанныеШапки.Дата);
		ПредставлениеПродавца = ФормированиеПечатныхФорм.ОписаниеОрганизации(
									ДанныеПродавца,
									"ПолноеНаименование");
									
		СтруктураДанныхШапки.Вставить("Продавец",ПредставлениеПродавца);
		СтруктураДанныхШапки.Вставить("АдресПродавца", ДанныеПродавца.ЮридическийАдрес+" "+ПредставлениеПродавца);
		СтруктураДанныхШапки.Вставить("ИННПродавца",ДанныеПродавца.ИНН);
		СтруктураДанныхШапки.Вставить("КПППродавца",ДанныеПродавца.КПП);
		СтруктураДанныхШапки.Вставить("Грузоотправитель",ПредставлениеПродавца);
		
		АдресГрузоотправителя = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ДанныеШапки.СкладТЧ,Справочники.ВидыКонтактнойИнформации.АдресСклада,ТекущаяДата(),Ложь);
		СтруктураДанныхШапки.Вставить("АдресГрузоотправителя",
			?(АдресГрузоотправителя.Количество() > 0, АдресГрузоотправителя[0].Представление, ""));
		
		ДанныеКонтрагента = ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ДанныеШапки.Контрагент, ДанныеШапки.Дата); 
		ПредставлениеПолучателя = ФормированиеПечатныхФорм.ОписаниеОрганизации(
									ДанныеКонтрагента,
									"ПолноеНаименование");   
		СтруктураДанныхШапки.Вставить("Грузополучатель",ПредставлениеПолучателя);							
		СтруктураДанныхШапки.Вставить("АдресГрузополучателя",ДанныеШапки.АдресДоставки);							
		СтруктураДанныхШапки.Вставить("Покупатель",ПредставлениеПолучателя);			
		СтруктураДанныхШапки.Вставить("АдресПокупателя",ДанныеКонтрагента.ЮридическийАдрес);
		//СтруктураДанныхШапки.Вставить("АдресПокупателя",ДанныеШапки.АдресДоставки);							
		СтруктураДанныхШапки.Вставить("ИННПокупателя",ДанныеКонтрагента.ИНН);							
		СтруктураДанныхШапки.Вставить("КПППокупателя",ДанныеКонтрагента.КПП);							
		
		ДанныеДоговора = "Номер договора "+ДанныеШапки.Договор.Номер+", Дата контракта "+Формат(ДанныеШапки.Договор.Дата,"ДФ=dd.MM.yyyy");
		СтруктураДанныхШапки.Вставить("Дополнение",ДанныеДоговора);							
		
		СтруктураДанныхШапки.Вставить("НомерПломбы","");							
		
		СтруктураПоиска = Новый Структура("Ссылка", ДанныеШапки.Ссылка);
		
		НомераТранспорта = Новый Массив;
		ТранспортныеНакладные = ДанныеШапки.Выбрать();
		Пока ТранспортныеНакладные.Следующий() Цикл
			  НомераТранспорта.Добавить(Строка(ТранспортныеНакладные.АвтомобильМарка)+" "+Строка(ТранспортныеНакладные.АвтомобильГосударственныйНомер));
		КонецЦикла;	  
		
		СтруктураДанныхШапки.Вставить("НомерТранспорта",СтрСоединить(НомераТранспорта,"/"));							
		
		ОбластьШапка.Параметры.Заполнить(СтруктураДанныхШапки);
		ТабличныйДокумент.Вывести(ОбластьШапка);
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		
		СтруктураПоиска = Новый Структура("Ссылка", ДанныеШапки.Ссылка);
		НайденСледующий = ДанныеТаблицы.НайтиСледующий(СтруктураПоиска);
		
			ОбластьИтог.Параметры.КоличествоКоробок = Окр(ДанныеТаблицы.КоличествоКоробок,0,РежимОкругления.Окр15как20);
			//ОбластьИтог.Параметры.КоличествоМест = ДанныеТаблицы.КоличествоМест;
			ОбластьИтог.Параметры.ВесНетто = ДанныеТаблицы.ВесНетто;
			//ОбластьИтог.Параметры.ВесНеттоУпаковка =ДанныеТаблицы.ВесБрутто*ДанныеТаблицы.КоличествоКоробок;     
			ОбластьИтог.Параметры.ВесНеттоУпаковка =ДанныеТаблицы.ВесНеттоУпаковка;
			ОбластьИтог.Параметры.ВесБрутто =   ДанныеТаблицы.ВесБрутто;
			ОбластьИтог.Параметры.Стоимость = ДанныеТаблицы.Сумма;
			//ОбластьИтог.Параметры.СуммаНалога = ДанныеТаблицы.СуммаНДС;
			ОбластьИтог.Параметры.Всего = ДанныеТаблицы.СуммаСНДС;
            ОбластьИтог.Параметры.КоличествоОбъем = ДанныеТаблицы.КоличествоОбъем;
		
		Если НайденСледующий Тогда
			
			ВыборкаПоТНВЭД = ДанныеТаблицы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			НомерСтроки = 1;
			Пока ВыборкаПоТНВЭД.Следующий() Цикл

				ВыборкаПоТоварам = ВыборкаПоТНВЭД.Выбрать();
				Пока ВыборкаПоТоварам.Следующий() цикл


				ДанныеСтроки = Новый Структура;
				ДанныеСтроки.Вставить("НПП",Формат(НомерСтроки,"ЧДЦ=0; ЧРГ=; ЧГ=0"));
				
				ДополнительныеПараметрыПолученияНаименованияДляПечати = НоменклатураКлиентСервер.ДополнительныеПараметрыПредставлениеНоменклатурыДляПечати();
					
				ПредставлениеНоменклатуры = НоменклатураКлиентСервер.ПредставлениеНоменклатурыДляПечати(
													ВыборкаПоТоварам.ТоварНаименованиеПолное,
													ВыборкаПоТоварам.Характеристика,
													,
													,
													ДополнительныеПараметрыПолученияНаименованияДляПечати);
				ДанныеСтроки.Вставить("Номенклатура",ПредставлениеНоменклатуры);
				ДанныеСтроки.Вставить("КодНоменклатуры", ВыборкаПоТоварам.Артикул);
				ДанныеСтроки.Вставить("ПродолжительностьПродажи", ВыборкаПоТоварам.СрокГодности);
				ДанныеСтроки.Вставить("КодТНВЭД",ВыборкаПоТоварам.КодТНВЭД);
				ДанныеСтроки.Вставить("КодТовара", ВыборкаПоТоварам.КодТовара);
				ДанныеСтроки.Вставить("КоличествоКоробок",Окр(ВыборкаПоТоварам.КоличествоКоробок,0,РежимОкругления.Окр15как20));    
				
				ДанныеСтроки.Вставить("КоличествоМест", ВыборкаПоТоварам.КоличествоМест);
				ДанныеСтроки.Вставить("ВесНеттоОдногоМеста", ВыборкаПоТОварам.ВесНеттоОдногоМеста);
				ДанныеСтроки.Вставить("ВесНетто", ВыборкаПоТОварам.ВесНетто);
				//ДанныеСтроки.Вставить("ВесНеттоУпаковка", ВыборкаПоТоварам.ВесБрутто*ВыборкаПоТоварам.КоличествоКоробок);    
				ДанныеСтроки.Вставить("ВесНеттоУпаковка", ВыборкаПоТоварам.ВесНеттоУпаковка);
				
				ДанныеСтроки.Вставить("ВесБрутто", ВыборкаПоТоварам.ВесБрутто);
				ДанныеСтроки.Вставить("ОбъемЛКг", ВыборкаПоТоварам.ОбъемЛКг);
				ДанныеСтроки.Вставить("КоличествоОбъем", ВыборкаПоТоварам.КоличествоОбъем);
				ДанныеСтроки.Вставить("Объем", ВыборкаПоТоварам.Объем);
				ДанныеСтроки.Вставить("ДатаПоставки", ВыборкаПоТоварам.ДатаПоставки);
				Коэффициент = 1; // всё отгружается штуками      
				Если ВыборкаПоТоварам.Весовой = Истина Тогда
					ДанныеСтроки.Вставить("Цена", Окр(ВыборкаПоТоварам.ЦенаЗаШт*ВыборкаПоТоварам.Упаковка.Числитель,2,РежимОкругления.Окр15как10)); 
				Иначе 
					ДанныеСтроки.Вставить("Цена", Окр(ВыборкаПоТоварам.ЦенаЗаШт*Коэффициент,2,РежимОкругления.Окр15как10)); 
				КонецЕсли;
				ДанныеСтроки.Вставить("Стоимость",Окр(ВыборкаПоТоварам.Сумма,2,РежимОкругления.Окр15как10));
				//ДанныеСтроки.Вставить("АкцизныйНалог", "-");
				//ДанныеСтроки.Вставить("СтавкаНалога", ВыборкаПоТоварам.СтавкаНДС);
				//ДанныеСтроки.Вставить("СуммаНалога", ВыборкаПоТоварам.СуммаНДС);
				ДанныеСтроки.Вставить("Всего", ВыборкаПоТоварам.СуммаСНДС);


				Если ЗначениеЗаполнено(ВыборкаПоТоварам.СертификатНоменклатуры) Тогда
					Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","СертификатыНоменклатуры_ТехническиеУсловия");	
					ТехУсловия = УправлениеСвойствами.ЗначениеСвойства(ВыборкаПоТоварам.СертификатНоменклатуры,Свойство);   
					ДанныеСтроки.Вставить("ТехническиеУсловия",ТехУсловия);
					ДанныеСтроки.Вставить("Декларация",?(ЗначениеЗаполнено(ВыборкаПоТоварам.СертификатНоменклатуры),ВыборкаПоТоварам.СертификатНоменклатуры.Номер,""));
				КонецЕсли;     
				
				ДанныеСтроки.Вставить("КодЕИ", ВыборкаПоТоварам.КодЕИ);
				ДанныеСтроки.Вставить("ЕИ", ВыборкаПоТоварам.НаименованиеЕИ);
				
				СтруктураПоиска = Новый Структура;
				СтруктураПоиска.Вставить("Номенклатура", ВыборкаПоТОварам.Номенклатура);
				СтруктураПоиска.Вставить("Характеристика", ВыборкаПоТОварам.Характеристика);
				СтруктураПоиска.Вставить("Упаковка", ВыборкаПоТОварам.Упаковка);
				СтрокиДляЗаполнения = ДанныеТаблицыПоСериям.НайтиСтроки(СтруктураПоиска); 
				
				МассивДат = новый Массив;      
				МассивПроизводителей = новый Массив;
				МассивСертификатов = новый Массив;
				
				Для Каждого Стр Из СтрокиДляЗаполнения Цикл
					Если МассивДат.Найти(Стр.ДатаПроизводства) <> Неопределено Тогда
						Продолжить;
					Иначе
						МассивДат.Добавить(Стр.ДатаПроизводства);
					КонецЕсли;  
					
					Если МассивПроизводителей.Найти(Стр.производитель)<> Неопределено  Тогда
						Продолжить;
					Иначе
						МассивПроизводителей.Добавить(Стр.производитель);
					КонецЕсли;

					Если МассивСертификатов.Найти(Стр.СертификатНоменклатуры)<> Неопределено  Тогда
						Продолжить;
					Иначе
						МассивСертификатов.Добавить(Стр.СертификатНоменклатуры);
					КонецЕсли;
					
				КонецЦикла;       
				
				ПервыйПроход = ИСтина; 
				ДатыПроизводства = "";  
				Для Каждого ДатаПроизводства Из МассивДат Цикл  
					Если ПервыйПроход Тогда
						ДатыПроизводства = ДатыПроизводства+Строка(Формат(ДатаПроизводства,"ДФ=dd.MM.yyyy"));
					Иначе 
						ДатыПроизводства = ДатыПроизводства+", "+Строка(Формат(ДатаПроизводства,"ДФ=dd.MM.yyyy"));
					КонецЕсли;
					ПервыйПроход = Ложь;
				КонецЦикла;
				
				ДанныеСтроки.Вставить("ДатаПроизводства",ДатыПроизводства);

				ПервыйПроход = ИСтина; 
				Производители = "";  
				Для Каждого Производитель Из МассивПроизводителей Цикл  
					Если ПервыйПроход Тогда
						Производители = Производители+Производитель;
					Иначе 
						Производители = Производители+", "+Производитель;
					КонецЕсли;
					ПервыйПроход = Ложь;
				КонецЦикла;
				
				ДанныеСтроки.Вставить("Производитель",Производители);
				
				ОбластьСтрока.Параметры.Заполнить(ДанныеСтроки);
				ТабличныйДокумент.Вывести(ОбластьСтрока);
				НомерСтроки = НомерСтроки+1;

			КонецЦикла;

			НомерСтрокиИтогТНВЭД = ТабличныйДокумент.ВысотаТаблицы + 1;
			ОбластьИтогТНВЭД.Параметры.КоличествоКоробок = Окр(ВыборкаПоТНВЭД.КоличествоКоробок, 0, РежимОкругления.Окр15как20);
			ОбластьИтогТНВЭД.Параметры.ВесНетто = ВыборкаПоТНВЭД.ВесНетто;
			ОбластьИтогТНВЭД.Параметры.ВесНеттоУпаковка = ВыборкаПоТНВЭД.ВесНеттоУпаковка;
			ОбластьИтогТНВЭД.Параметры.ВесБрутто = ВыборкаПоТНВЭД.ВесБрутто;
			ОбластьИтогТНВЭД.Параметры.КоличествоОбъем = ВыборкаПоТНВЭД.КоличествоОбъем;
			ОбластьИтогТНВЭД.Параметры.Стоимость = ВыборкаПоТНВЭД.Сумма;
			ОбластьИтогТНВЭД.Параметры.Всего = ВыборкаПоТНВЭД.СуммаСНДС;
			ТабличныйДокумент.Вывести(ОбластьИтогТНВЭД);
			ТабличныйДокумент.Область(НомерСтрокиИтогТНВЭД, 1, НомерСтрокиИтогТНВЭД, 4).Текст = "Итого по ТН ВЭД " + ВыборкаПоТНВЭД.КодТНВЭД;

		КонецЦикла;
		ТабличныйДокумент.Вывести(ОбластьИтог);
	КонецЕсли;
		Если ТипЗнч(ОбъектыПечати) = Тип("СписокЗначений") Тогда
			УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеШапки.Ссылка);
		КонецЕсли;
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;

КонецФункции                 

